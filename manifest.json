{
  "manifest_version": 3,
  "name": "FB Lightning Scroller",
  "version": "1.0.0",
  "description": "Scroll Facebook's feed to the bottom at lightning speed, buffering posts in RAM then IndexedDB.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["https://www.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
